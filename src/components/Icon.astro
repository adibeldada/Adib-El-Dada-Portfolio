---
// the few icons the site uses, drawn on a 24x24 grid
interface Props {
	name: 'arrow' | 'sun' | 'moon';
	class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{name === 'arrow' && <path d="M7 17L17 7M8.5 7H17v8.5" />}
	{
		name === 'sun' && (
			<>
				<circle cx="12" cy="12" r="4" />
				<path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
			</>
		)
	}
	{name === 'moon' && <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z" />}
</svg>
