---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>

		<div class="internal-links">
			<a href="/">Home</a>
			<a href="/about">About</a>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 0 1rem;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
	}

	h2 {
		margin: 0;
		font-size: 1.2rem;
	}

	h2 a {
		text-decoration: none;
		color: var(--black);
	}

	.internal-links {
		display: flex;
		gap: 1rem;
	}

	.internal-links a {
		padding: 1rem 0.5rem;
		color: var(--black);
		text-decoration: none;
	}

	.internal-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			padding: 1rem 0;
			gap: 0.5rem;
		}
	}
</style>