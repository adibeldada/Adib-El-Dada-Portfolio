---
// the card that shows up next to a stop on the map: what the project is, its live demo
// (goes in the slot), and what i did on it. the text comes from data/projects.ts
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { textOn } from '../scripts/color';

interface Props {
	project: Project;
	number: number;
}
const { project, number } = Astro.props;
// a live demo if one got passed in, otherwise a screenshot if there is one, otherwise neither
const hasDemo = Astro.slots.has('default');
---

<article class="card" style={`--c1: ${project.icon[0]}; --c2: ${project.icon[1]}; --on-c1: ${textOn(project.icon[0])}`}>
	<p class="stop"><span class="num">{number}</span>stop {number} · {project.when}</p>
	<h2>
		{project.name}
		{project.status && <span class="status">{project.status}</span>}
	</h2>
	<p class="tagline">{project.tagline}</p>
	<p class="meta">
		{project.team ? `built with ${project.team}` : 'solo project'}
		{project.award && <span class="award">{project.award}</span>}
	</p>
	{
		project.working && (
			<p class="working">
				<b>working now:</b> {project.working}
			</p>
		)
	}

	{hasDemo && <div class="demo"><slot /></div>}
	{!hasDemo && project.image && <img class="demo shot" src={project.image} alt={`${project.name} screenshot`} loading="lazy" />}

	<p class="about">{project.about}</p>
	<h3>what i did</h3>
	<ul class="mine">
		{project.mine.map((line) => <li>{line}</li>)}
	</ul>
	<p class="stack">{project.stack.join(', ')}</p>
	<p class="links">
		{
			project.demo && (
				<a href={project.demo} target="_blank" rel="noopener noreferrer">
					live demo <Icon name="arrow" />
				</a>
			)
		}
		<a href={project.github} target="_blank" rel="noopener noreferrer">
			code <Icon name="arrow" />
		</a>
	</p>
</article>

<style>
	.card {
		width: min(470px, 100%);
		padding: 26px;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		/* nearly solid, with no backdrop blur: a blur over the moving map is slow on weaker computers */
		background: color-mix(in oklab, var(--card) 96%, transparent);
		box-shadow: var(--lift);
		pointer-events: auto;
	}

	.stop {
		display: flex;
		align-items: center;
		gap: 9px;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink-2);
	}
	/* the stop's number, painted like a trail blaze */
	.num {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 5px;
		background: var(--c1);
		color: var(--on-c1);
		font-size: 12px;
		font-weight: 800;
	}
	h2 {
		margin-top: 12px;
		font: 800 clamp(30px, 3.4vw, 40px) / 1 var(--font-display);
		letter-spacing: -0.035em;
	}
	/* "in progress", scribbled next to the name */
	.status {
		display: inline-block;
		margin-left: 6px;
		font: 600 24px var(--font-hand);
		letter-spacing: 0;
		color: var(--accent);
		rotate: -4deg;
		translate: 0 -4px;
		white-space: nowrap;
	}
	.tagline {
		margin-top: 8px;
		font-size: 16.5px;
		line-height: 1.4;
		color: var(--ink-2);
	}
	.meta {
		margin-top: 12px;
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink-2);
	}
	.award {
		display: block;
		color: var(--ink);
		font-weight: 700;
	}
	/* what already works on an in-progress project */
	.working {
		margin-top: 12px;
		padding: 10px 12px;
		border-radius: 6px;
		background: var(--fill);
		font-size: 14px;
		line-height: 1.5;
	}

	.demo {
		margin: 20px -8px 0;
		border-radius: calc(var(--radius) - 2px);
		overflow: hidden;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--c1) 7%, var(--card));
	}
	.shot {
		display: block;
		width: calc(100% + 16px);
		height: auto;
	}

	.about {
		margin-top: 20px;
		font-size: 15.5px;
		line-height: 1.6;
	}
	h3 {
		margin: 20px 0 8px;
		font-size: 15px;
		font-weight: 800;
	}
	.mine {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.mine li {
		position: relative;
		padding-left: 18px;
		font-size: 15px;
		line-height: 1.55;
	}
	/* a little dash of the project's color, like a bit of trail */
	.mine li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 9px;
		height: 3px;
		border-radius: 2px;
		background: var(--c1);
	}
	.stack {
		margin-top: 16px;
		font: 500 13px / 1.6 var(--font-mono);
		color: var(--ink-2);
	}
	.links {
		display: flex;
		gap: 18px;
		margin-top: 16px;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--c1);
	}
	.links :global(svg) {
		width: 15px;
		height: 15px;
	}

	@media (max-width: 560px) {
		.card {
			padding: 20px;
		}
		.demo {
			margin-inline: -6px;
		}
	}
</style>
