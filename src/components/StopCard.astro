---
// the card that shows up next to a stop on the map: what the project is, its live demo
// (goes in the slot), and what i did on it. the text comes from data/projects.ts
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	number: number;
}
const { project, number } = Astro.props;
// a live demo if one got passed in, otherwise a screenshot if there is one, otherwise neither
const hasDemo = Astro.slots.has('default');
---

<article class="card" style={`--c1: ${project.icon[0]}; --c2: ${project.icon[1]}`}>
	<p class="stop"><span class="num">{number}</span>stop {number} · {project.when}</p>
	<h2>{project.name}</h2>
	<p class="tagline">{project.tagline}</p>
	<p class="badges">
		<span class="team">👥 built with {project.team}</span>
		{project.award && <span class="award">🏆 {project.award}</span>}
	</p>

	{hasDemo && <div class="demo"><slot /></div>}
	{!hasDemo && project.image && <img class="demo shot" src={project.image} alt={`${project.name} screenshot`} loading="lazy" />}

	<p class="about">{project.about}</p>
	<h3>what i did</h3>
	<ul class="mine">
		{project.mine.map((line) => <li>{line}</li>)}
	</ul>
	<ul class="stack">
		{project.stack.map((tech) => <li>{tech}</li>)}
	</ul>
	<p class="links">
		{
			project.demo && (
				<a href={project.demo} target="_blank" rel="noopener noreferrer">
					live demo <Icon name="arrow" />
				</a>
			)
		}
		<a href={project.github} target="_blank" rel="noopener noreferrer">
			code <Icon name="arrow" />
		</a>
	</p>
</article>

<style>
	.card {
		width: min(470px, 100%);
		padding: 26px;
		border-radius: 28px;
		border: 1px solid var(--line);
		/* nearly solid, with no backdrop blur: a blur over the moving map is slow on weaker computers */
		background: color-mix(in oklab, var(--card) 95%, transparent);
		box-shadow: 0 40px 90px -50px rgba(20, 15, 10, 0.6);
		pointer-events: auto;
	}

	.stop {
		display: flex;
		align-items: center;
		gap: 9px;
		font: 600 12px var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.num {
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--c1), var(--c2));
		color: #fff;
		font: 800 12px var(--font-ui);
		letter-spacing: 0;
	}
	h2 {
		margin-top: 12px;
		font: 800 clamp(30px, 3.4vw, 40px) / 1 var(--font-display);
		letter-spacing: -0.035em;
	}
	.tagline {
		margin-top: 8px;
		font-size: 16.5px;
		line-height: 1.4;
		color: var(--ink-2);
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 14px;
	}
	.team,
	.award {
		padding: 5px 11px;
		border-radius: 99px;
		font-size: 12.5px;
		font-weight: 700;
	}
	.team {
		color: color-mix(in oklab, var(--c1) 65%, var(--ink));
		background: color-mix(in oklab, var(--c1) 14%, transparent);
	}
	.award {
		color: color-mix(in oklab, #d4930f 75%, var(--ink));
		background: color-mix(in oklab, #f5b82e 18%, transparent);
	}

	.demo {
		margin: 20px -8px 0;
		border-radius: 22px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: linear-gradient(165deg, color-mix(in oklab, var(--c1) 16%, var(--card)), var(--card) 72%);
	}
	.shot {
		display: block;
		width: calc(100% + 16px);
		height: auto;
	}

	.about {
		margin-top: 20px;
		font-size: 15.5px;
		line-height: 1.6;
	}
	h3 {
		margin: 20px 0 9px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.mine {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.mine li {
		position: relative;
		padding-left: 18px;
		font-size: 15px;
		line-height: 1.55;
	}
	.mine li::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.62em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: linear-gradient(145deg, var(--c1), var(--c2));
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 16px;
	}
	.stack li {
		padding: 5px 10px;
		border-radius: 99px;
		background: var(--fill);
		font-size: 12.5px;
		font-weight: 600;
	}
	.links {
		display: flex;
		gap: 18px;
		margin-top: 18px;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--c1);
	}
	.links :global(svg) {
		width: 15px;
		height: 15px;
	}

	@media (max-width: 560px) {
		.card {
			padding: 20px;
		}
		.demo {
			margin-inline: -6px;
		}
	}
</style>
