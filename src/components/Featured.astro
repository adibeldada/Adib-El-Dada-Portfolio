---
// the featured row under the intro: the projects worth seeing first, each card jumping to its stop on the
// trail (clicking one flies the map there). which ones and in what order: `featured` in data/projects.ts.
// each card shows the project's tagline and one line of proof (`highlight` in projects.ts, or where and
// when it was built), plus a live demo link if it has one
import { projects, featured } from '../data/projects';
import { textOn } from '../scripts/color';

const picks = featured.map((id) => {
	const index = projects.findIndex((p) => p.id === id);
	if (index < 0) throw new Error(`featured: no project with id "${id}"`);
	return { project: projects[index], number: index + 1 };
});
---

<section class="featured" aria-labelledby="featured-title">
	<h2 id="featured-title">featured</h2>
	<ul>
		{
			picks.map(({ project, number }) => (
				<li style={`--c: ${project.icon[0]}; --on-c: ${textOn(project.icon[0])}`}>
					<p class="where">
						<b>{number}</b>
						stop {number}
						{!project.team && <span class="badge">solo</span>}
						{project.status && <span class="badge now">{project.status}</span>}
					</p>
					<h3>
						{/* this link covers the whole card (see .go::after), so clicking anywhere jumps to the stop */}
						<a class="go" href={`#${project.id}`}>
							{project.name}
						</a>
					</h3>
					<p class="line">{project.tagline}</p>
					<p class="proof">
						{project.highlight ?? `${project.context} · ${project.when}`}
						{
							project.demo && (
								<a class="demo" href={project.demo} target="_blank" rel="noopener noreferrer">
									live demo ↗
								</a>
							)
						}
					</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.featured {
		margin-top: 34px;
	}
	h2 {
		font-size: 15px;
		font-weight: 800;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		margin-top: 10px;
	}
	/* on a wide screen the row gets a little more room than the text above it */
	@media (min-width: 1200px) {
		ul {
			width: 640px;
		}
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 5px;
		padding: 12px;
		border-radius: 8px;
		border: 1px solid var(--line);
		background: var(--card);
		transition: border-color 0.15s;
	}
	li:hover {
		border-color: var(--c);
	}
	.where {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 5px 6px;
		font-size: 12.5px;
		font-weight: 600;
		color: var(--ink-2);
	}
	/* the stop's number, painted like a trail blaze (same as on the map and the cards) */
	b {
		display: grid;
		place-items: center;
		width: 18px;
		height: 18px;
		border-radius: 4px;
		background: var(--c);
		color: var(--on-c);
		font-size: 11px;
		font-weight: 800;
	}
	.badge {
		padding: 1px 6px;
		border-radius: 4px;
		border: 1px solid var(--line);
		font-size: 11px;
		font-weight: 650;
		line-height: 1.4;
	}
	.badge.now {
		border-color: color-mix(in oklab, var(--accent) 40%, var(--line));
		color: var(--accent);
	}
	h3 {
		margin-top: 2px;
		font: 800 18px / 1.1 var(--font-display);
		letter-spacing: -0.02em;
	}
	.go {
		text-decoration: none;
	}
	.go::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	.go:focus-visible {
		outline: none;
	}
	li:has(.go:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.line {
		font-size: 13.5px;
		line-height: 1.4;
		color: var(--ink-2);
	}
	.proof {
		margin-top: auto;
		padding-top: 4px;
		font: 500 11.5px / 1.5 var(--font-mono);
		color: var(--ink);
	}
	/* sits above the card's link, so it opens the demo instead of jumping to the stop */
	.demo {
		position: relative;
		z-index: 1;
		display: inline-block;
		margin-left: 2px;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--c);
		text-underline-offset: 3px;
	}

	/* the plain version of the page (no 3D) centers the intro, but these read better left-aligned */
	:global(.no-map) .featured {
		text-align: left;
	}

	/* phones: one under the other */
	@media (max-width: 560px) {
		ul {
			grid-template-columns: 1fr;
		}
		.demo {
			padding-block: 10px;
			margin-block: -10px;
		}
	}
</style>
