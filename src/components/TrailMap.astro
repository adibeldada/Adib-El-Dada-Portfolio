---
// the 3D map behind the page, plus a clickable label floating over every stop.
// all the 3D code lives in src/map/
import { projects } from '../data/projects';
import { textOn } from '../scripts/color';
---

<div class="map" aria-hidden="true">
	<canvas data-map-canvas></canvas>
	<div class="labels" data-map-labels>
		<a class="label start" href="#about" data-stop="start" tabindex="-1"><span class="tag">hi, i'm adib</span></a>
		{
			projects.map((p, i) => (
				<a class="label" href={`#${p.id}`} data-stop={p.id} tabindex="-1" style={`--c: ${p.icon[0]}; --on-c: ${textOn(p.icon[0])}`}>
					<span class="tag">
						<b>{i + 1}</b>
						{p.name}
					</span>
				</a>
			))
		}
		<a class="label summit" href="#summit" data-stop="summit" tabindex="-1"><span class="tag"><b>⚑</b>next stop: your team?</span></a>
	</div>
</div>

<script>
	import { startMap } from '../map';

	// (this script never holds up the page's text: browsers run it after the page is parsed. the world is
	// then built in small pieces, see startMap, so a slow phone can still scroll and tap meanwhile)
	startMap(document.querySelector<HTMLCanvasElement>('[data-map-canvas]')!, document.querySelector<HTMLElement>('[data-map-labels]')!);
</script>

<style>
	.map {
		position: fixed;
		inset: 0 0 auto 0;
		height: 100vh;
		height: 100lvh; /* the "large" viewport, so phones don't resize it every time the url bar moves */
		z-index: 0;
		pointer-events: none;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	:global(.no-map) .map {
		display: none;
	}

	/* the map and its labels fade in once the first frame is drawn */
	canvas,
	.labels {
		opacity: 0;
		transition: opacity 0.9s ease;
	}
	.map:global(.ready) canvas,
	.map:global(.ready) .labels {
		opacity: 1;
	}

	.labels {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}
	/* each label is two parts. the <a> is an invisible point that the script moves onto its pin every
	   frame. the .tag is what you see, hanging just above that point. growing the tag on hover (below)
	   scales it around its own bottom edge, so it never slides away from the mouse. (scaling the moving
	   <a> itself would scale its position on screen too, and the label would jump ~80px away) */
	.label {
		position: absolute;
		left: 0;
		top: 0;
		color: var(--ink);
		text-decoration: none;
		pointer-events: auto;
		/* labels move every frame the camera moves: their own layer makes that cheap for the browser */
		will-change: transform;
		transition: opacity 0.35s ease;
	}
	.tag {
		position: absolute;
		left: 0;
		bottom: 6px;
		display: flex;
		align-items: center;
		gap: 7px;
		width: max-content;
		padding: 4px 10px 4px 4px;
		border-radius: 6px;
		border: 1px solid var(--line);
		/* (no backdrop blur here on purpose: blurring what's behind a label means redoing the blur
		   every time the map redraws, which is slow on weaker computers) */
		background: var(--card);
		box-shadow: 0 3px 8px -4px rgba(0, 0, 0, 0.35);
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
		translate: -50% 0;
		transform-origin: 50% 100%;
		transition: scale 0.25s ease-out;
	}
	/* the notch pointing down at the pin */
	.tag::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -5px;
		width: 8px;
		height: 8px;
		border: solid var(--line);
		border-width: 0 1px 1px 0;
		background: inherit;
		translate: -50% 0;
		rotate: 45deg;
	}
	/* the stop's number, painted like a trail blaze */
	.tag b {
		display: grid;
		place-items: center;
		width: 20px;
		height: 20px;
		border-radius: 4px;
		background: var(--c);
		color: var(--on-c);
		font-size: 11.5px;
	}
	.label:hover .tag,
	.label[data-active] .tag {
		scale: 1.08;
	}
	/* when you're at a stop, the other labels step back */
	.labels[data-mode='focus'] .label:not([data-active]) {
		opacity: 0.3;
	}
	.label[data-off] {
		opacity: 0 !important;
		pointer-events: none;
	}
	/* the trailhead's label has no number, so it doesn't need the badge's padding */
	.start .tag {
		padding: 4px 12px;
	}
	.summit .tag {
		border-color: var(--accent-strong);
		background: var(--accent-strong);
		color: #fff;
	}
	.summit .tag::after {
		border-color: var(--accent-strong);
	}
	.summit b {
		background: rgba(255, 255, 255, 0.25);
	}

	/* phones: in the overview there's no room for names, so just show the numbered dots */
	@media (max-width: 560px) {
		.labels[data-mode='all'] .tag {
			gap: 0;
			padding: 3px;
			font-size: 0;
		}
		.labels[data-mode='all'] .tag::after {
			display: none;
		}
		.labels[data-mode='all'] .start {
			display: none;
		}
	}
</style>
