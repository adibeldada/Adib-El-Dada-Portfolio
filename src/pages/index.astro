---
// the whole site. the 3D trail map sits fixed in the background, and every <section> with a
// data-shot is one step down the trail: scroll to a section and the camera flies to its stop.
// order: intro → the trailhead (about me) → one section per project (stops 1-4) → the summit → contact
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TrailMap from '../components/TrailMap.astro';
import TrailBar from '../components/TrailBar.astro';
import StopCard from '../components/StopCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import VisitorCount from '../components/VisitorCount.astro';
import TriageFlowDemo from '../components/demos/TriageFlowDemo.astro';
import BridgeAidDemo from '../components/demos/BridgeAidDemo.astro';
import CatanDemo from '../components/demos/CatanDemo.astro';
import AnattackDemo from '../components/demos/AnattackDemo.astro';
import { projects } from '../data/projects';
import { profile, education, experience, competitions, skills } from '../data/profile';

// which live demo goes with which project. a project doesn't need one: leave it out
// and its card just shows its screenshot (or nothing)
const demos: Record<string, typeof TriageFlowDemo | undefined> = {
	triageflow: TriageFlowDemo,
	bridgeaid: BridgeAidDemo,
	catan: CatanDemo,
	anattack: AnattackDemo,
};
---

<Base>
	<TrailMap />

	<header class="top">
		<a class="wordmark" href="#top">adib<span class="rest"> el dada</span></a>
		<div class="actions">
			<a class="resume" href={profile.resumePdf} download="Adib_El_Dada_Resume.pdf">résumé <Icon name="download" /></a>
			<ThemeToggle />
		</div>
	</header>

	<main>
		<section class="step intro" id="top" data-shot="intro">
			<div class="intro-copy">
				<p class="status">
					<span class="dot"></span>
					<span>{profile.status} · {profile.location}</span>
					<VisitorCount />
				</p>
				<h1>Adib El Dada</h1>
				<p class="lede">
					Software Engineering &amp; Business Management student at McMaster. I learn by building: the backend of a hospital triage
					app, a live disaster-response map, a Catan engine you can undo.
				</p>
				<p class="lede map-only">This map is my trail so far. Every stop is something I built with a team.</p>
				<p class="cta">
					<a class="go" href="#about">walk the trail <span aria-hidden="true">↓</span></a>
					<a href={profile.github} target="_blank" rel="noopener noreferrer">github <Icon name="arrow" /></a>
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer">linkedin <Icon name="arrow" /></a>
					<a href={`mailto:${profile.email}`}>email <Icon name="arrow" /></a>
				</p>
			</div>
			<p class="hint map-only">scroll to walk it, or click any stop on the map</p>
		</section>

		<section class="step stop trailhead" id="about" data-shot="start">
			<article class="card story">
				<p class="kicker">the trailhead · about me</p>
				<h2>Hey, I'm Adib.</h2>
				<p>
					I'm in third year of Software Engineering &amp; Business Management Student at McMaster University, I'm interested in software, AI, and the systems behind the things we utilize daily.
				</p>
				<p>
					I like learning by building. A lot fo what I've learned has come from working on projects, joining hackathons, and picking up new technologies as I go. I enjoy taking an idea, figuring out how to make it work and seeing it turn into something real.
					
				</p>
				<p>
					Here are some of the things I've built along the way.	
				</p>
				<p class="note">the trail starts here ↓</p>
			</article>
		</section>

		{
			projects.map((project, i) => {
				const Demo = demos[project.id];
				return (
					<section class="step stop" id={project.id} data-shot={project.id}>
						{Demo ? (
							<StopCard project={project} number={i + 1}>
								<Demo />
							</StopCard>
						) : (
							<StopCard project={project} number={i + 1} />
						)}
					</section>
				);
			})
		}

		<section class="step stop" id="summit" data-shot="summit">
			<article class="card story">
				<p class="kicker">⚑ the summit</p>
				<h2>What I'm after</h2>
				<p>
					Problems I can actually point at. TriageFlow is about ER patients answering the same questions over and over. BridgeAid is
					about how messy information gets during an emergency. I like projects where it's obvious who they're for and whether they
					worked.
				</p>

				<h3>the team part</h3>
				<p>
					Every stop on this map was a team project, and I like it that way: splitting up the work, going back and forth on the design,
					and sorting out the parts nobody planned for.
				</p>
				<p class="note">hiring for co-op? say hi ↓</p>

				<dl class="facts">
					<div>
						<dt>education</dt>
						<dd>
							<p>
								<b>{education.school}</b> <span class="when">{education.when}</span>
								<span class="sub">{education.degrees} · {education.note}</span>
							</p>
						</dd>
					</div>
					<div>
						<dt>experience</dt>
						<dd>
							{
								experience.map((job) => (
									<p>
										<b>
											{job.role}, {job.org}
										</b>{' '}
										<span class="when">{job.when}</span>
									</p>
								))
							}
						</dd>
					</div>
					<div>
						<dt>competitions</dt>
						<dd>
							{
								competitions.map((c) => (
									<p>
										<b>{c.name}</b> <span class="when">{c.when}</span>
										<span class="sub">{c.result}</span>
									</p>
								))
							}
						</dd>
					</div>
					<div>
						<dt>skills</dt>
						<dd><p class="sub">{skills.join(' · ')}</p></dd>
					</div>
				</dl>
			</article>
		</section>

		<section class="step end" id="contact" data-shot="contact">
			<div class="card contact">
				<h2>say hi</h2>
				<p>If you're hiring for co-op, building something that helps people, or just want to talk, my inbox is open.</p>
				<a class="email" href={`mailto:${profile.email}`}>{profile.email} <Icon name="arrow" /></a>
				<p class="elsewhere">
					<a href={profile.github} target="_blank" rel="noopener noreferrer">github</a>
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
					<a href={profile.resumePdf} download="Adib_El_Dada_Resume.pdf">résumé <Icon name="download" /></a>
				</p>
				<p class="foot">
					built with astro + three.js, hosted on cloudflare · <a href={profile.source} target="_blank" rel="noopener noreferrer">source</a> ·
					© {new Date().getFullYear()}
				</p>
			</div>
		</section>
	</main>

	<TrailBar />
</Base>

<style>
	/* ---- header ---- */
	.top {
		position: fixed;
		inset: 0 0 auto;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px clamp(20px, 4vw, 48px);
		pointer-events: none;
	}
	.top > * {
		pointer-events: auto;
	}
	.wordmark {
		font: 800 19px var(--font-display);
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.resume {
		padding: 8px 14px;
		border-radius: 99px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--card) 80%, transparent);
		font-size: 14px;
		font-weight: 650;
		text-decoration: none;
	}
	.resume,
	.elsewhere a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}
	.resume :global(svg),
	.elsewhere :global(svg) {
		width: 14px;
		height: 14px;
	}

	/* ---- sections sit on top of the map. only the text/cards catch clicks,
	   so you can still click the stops on the map through the empty space ---- */
	main {
		position: relative;
		z-index: 2;
		pointer-events: none;
	}
	/* (styled by class, not "main section": astro's scoping makes element selectors
	   more specific than they look, and they'd override .stop / .end below) */
	.step {
		position: relative;
		display: flex;
		min-height: 100vh;
		padding: 16vh clamp(20px, 5vw, 80px) 120px;
		pointer-events: none;
	}
	.intro-copy,
	.step :global(.card) {
		pointer-events: auto;
	}

	/* ---- intro ---- */
	.intro {
		flex-direction: column;
		justify-content: center;
		padding-top: 90px;
	}
	.intro-copy {
		position: relative;
		max-width: 520px;
	}
	/* a soft fade behind the intro text, in case the map drifts under it on mid-size screens */
	.intro::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, color-mix(in oklab, var(--bg) 88%, transparent) 0%, transparent 52%);
		pointer-events: none;
	}
	.intro-copy > * {
		animation: rise 0.9s var(--spring) both;
	}
	.intro-copy > :nth-child(2) {
		animation-delay: 0.08s;
	}
	.intro-copy > :nth-child(3) {
		animation-delay: 0.16s;
	}
	.intro-copy > :nth-child(4) {
		animation-delay: 0.22s;
	}
	.intro-copy > :nth-child(5) {
		animation-delay: 0.28s;
	}
	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 20px;
		}
	}
	.status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 10px;
		font-size: 14px;
		color: var(--ink-2);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--good);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--good) 22%, transparent);
	}
	h1 {
		margin-top: 16px;
		font: 800 clamp(52px, 7.4vw, 100px) / 0.9 var(--font-display);
		letter-spacing: -0.05em;
	}
	.lede {
		margin-top: 18px;
		font-size: clamp(17px, 1.6vw, 19px);
		line-height: 1.55;
		color: var(--ink-2);
	}
	.lede + .lede {
		margin-top: 10px;
		color: var(--ink);
		font-weight: 600;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 28px;
	}
	.cta a {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 10px 16px;
		border-radius: 99px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--card) 70%, transparent);
		font-size: 15px;
		font-weight: 650;
		text-decoration: none;
		transition:
			background 0.2s,
			color 0.2s,
			scale 0.2s var(--spring);
	}
	.cta a:hover {
		background: var(--ink);
		color: var(--bg);
	}
	.cta a:active {
		scale: 0.96;
	}
	.cta .go {
		border-color: transparent;
		background: var(--accent);
		color: #fff;
	}
	.cta :global(svg) {
		width: 15px;
		height: 15px;
	}
	.hint {
		position: absolute;
		left: clamp(20px, 5vw, 80px);
		bottom: 110px;
		font: 600 22px var(--font-hand);
		color: var(--ink-2);
		rotate: -2deg;
		animation: bob 2.6s ease-in-out infinite;
	}
	@keyframes bob {
		50% {
			translate: 0 -5px;
		}
	}

	/* ---- stops: the card on the right, the map stop on the left ---- */
	.stop {
		min-height: 165vh;
		justify-content: flex-end;
		align-items: flex-start;
	}
	/* the trailhead card is short, so its stretch of trail is too */
	.trailhead {
		min-height: 135vh;
	}

	/* ---- the story cards (the trailhead and the summit) ---- */
	.card {
		width: min(470px, 100%);
		padding: 26px;
		border-radius: 28px;
		border: 1px solid var(--line);
		background: color-mix(in oklab, var(--card) 95%, transparent);
		box-shadow: 0 40px 90px -50px rgba(20, 15, 10, 0.6);
	}
	.kicker {
		font: 600 12px var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.card h2 {
		margin-top: 10px;
		font: 800 clamp(30px, 3.4vw, 40px) / 1 var(--font-display);
		letter-spacing: -0.035em;
	}
	.story p {
		margin-top: 14px;
		font-size: 15.5px;
		line-height: 1.65;
	}
	.story h3 {
		margin-top: 22px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.story h3 + p {
		margin-top: 6px;
	}
	.story .note {
		font: 600 24px var(--font-hand);
		color: var(--accent);
		rotate: -1.5deg;
	}
	.facts {
		margin-top: 22px;
		font-size: 13.5px;
		line-height: 1.5;
	}
	.facts > div {
		display: grid;
		grid-template-columns: 98px 1fr;
		gap: 10px;
		padding: 10px 0;
		border-top: 1px solid var(--line);
	}
	.facts dt {
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
	}
	.facts dd {
		display: flex;
		flex-direction: column;
		gap: 7px;
	}
	/* (beats the bigger ".story p" text size above) */
	.story .facts p {
		margin-top: 0;
		font-size: 13.5px;
		line-height: 1.5;
	}
	.facts .when {
		color: var(--ink-2);
		white-space: nowrap; /* so "May – Aug 2025" never splits across lines */
	}
	.facts .sub {
		display: block;
		color: var(--ink-2);
	}

	/* ---- contact ---- */
	.end {
		min-height: 110vh;
		justify-content: center;
		align-items: center;
	}
	.contact {
		text-align: center;
		width: min(520px, 100%);
	}
	.contact p {
		margin-top: 12px;
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink-2);
	}
	.email {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 18px;
		font: 800 clamp(20px, 3vw, 28px) var(--font-display);
		letter-spacing: -0.03em;
		text-decoration: none;
		border-bottom: 3px solid var(--accent);
	}
	.email :global(svg) {
		width: 0.8em;
		height: 0.8em;
	}
	.elsewhere {
		display: flex;
		justify-content: center;
		gap: 18px;
	}
	.elsewhere a {
		color: var(--ink);
		font-weight: 650;
	}
	.contact .foot {
		font-size: 12.5px;
	}
	.foot a {
		color: inherit;
	}

	/* ---- a browser that can't do 3D at all (very rare): a plain, centered page ---- */
	:global(.no-map) .map-only {
		display: none;
	}
	:global(.no-map) .step {
		min-height: auto;
		justify-content: center;
		padding-block: 72px;
	}
	:global(.no-map) .intro {
		align-items: center;
		text-align: center;
		padding-top: 140px;
	}
	:global(.no-map) .intro-copy .status,
	:global(.no-map) .intro-copy .cta {
		justify-content: center;
	}
	:global(.no-map) .intro::before {
		display: none;
	}

	/* ---- phones: the map fills the top of the screen, cards slide up from below ---- */
	@media (max-width: 820px) {
		.step {
			padding-inline: 14px;
		}
		.intro {
			justify-content: flex-end;
			padding-bottom: 120px;
		}
		.intro-copy {
			padding: 20px;
			border-radius: 24px;
			background: color-mix(in oklab, var(--bg) 90%, transparent);
		}
		.hint {
			display: none;
		}
		.stop {
			min-height: auto;
			justify-content: center;
			padding-top: 64vh;
			padding-bottom: 36vh;
		}
		.end {
			align-items: flex-end;
			padding-bottom: 120px;
		}
	}
	@media (max-width: 560px) {
		.rest {
			display: none;
		}
		.card {
			padding: 20px;
		}
		.facts > div {
			grid-template-columns: 1fr;
			gap: 4px;
		}
	}
</style>
