---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Adib El Dada - Software Engineering student and developer." />
		<title>Adib El Dada | Portfolio</title>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<p class="intro">Hi, I'm</p>
				<h1>Adib El Dada</h1>
				<h2>Software Engineering Student</h2>

				<p class="description">
					I'm a Software Engineering and Management student at McMaster University
					who enjoys building software, learning new technologies, and working
					on interesting projects..
				</p>

				<div class="buttons">
					<a href="/about" class="primary">About Me</a>
					<a href="/projects" class="primary">Projects</a>
					<a href="https://github.com/adibeldada" target="_blank" class="secondary">
						GitHub
					</a>
					
					</a>

					


				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1000px;
		margin: 0 auto;
		padding: 6rem 2rem;
	}

	.hero {
		max-width: 700px;
	}

	.intro {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
	}

	h1 {
		font-size: 4rem;
		margin: 0;
	}

	h2 {
		font-size: 2rem;
		font-weight: 400;
		margin-top: 0.5rem;
		color: #6b7280;
	}

	.description {
		font-size: 1.2rem;
		line-height: 1.7;
		margin-top: 2rem;
	}

	.buttons {
		display: flex;
		gap: 1rem;
		margin-top: 2rem;
	}

	.buttons a {
		padding: 0.8rem 1.5rem;
		border-radius: 8px;
		text-decoration: none;
	}

	.primary {
		background: #111827;
		color: white;
	}

	.secondary {
		border: 1px solid #d1d5db;
		color: #111827;
	}

	@media (max-width: 600px) {
		h1 {
			font-size: 3rem;
		}

		h2 {
			font-size: 1.5rem;
		}
	}
</style>