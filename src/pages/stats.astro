---
// /stats: who's been looking at the site, where each of them went, what they clicked, and roughly
// where they were. only for me: it asks for the password (the STATS_PASSWORD secret), then a cookie
// keeps me logged in for 30 days and keeps my own visits out of the numbers.
// /stats lists everyone; /stats?person=<id> shows one person's visits, step by step.
// the data comes from src/scripts/track.ts → src/pages/api/track.ts
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { statsEnv, passwordMatches, makeOwnerCookie, isOwner, loginBlocked, noteFailure, whoIs, OWNER_COOKIE, OWNER_DAYS } from '../server/stats';

export const prerender = false;

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');

const { STATS: db, STATS_PASSWORD: password } = statsEnv(Astro.locals);
const setUp = Boolean(db && password);
let error = '';

if (Astro.request.method === 'POST' && db && password) {
	const form = await Astro.request.formData();
	if (form.get('action') === 'logout') {
		Astro.cookies.delete(OWNER_COOKIE, { path: '/' });
		return Astro.redirect('/stats', 303);
	}
	const who = await whoIs(Astro.request);
	if (await loginBlocked(db, who)) {
		error = 'Too many wrong tries. Wait 15 minutes and try again.';
		Astro.response.status = 429;
	} else if (await passwordMatches(String(form.get('password') ?? ''), password)) {
		Astro.cookies.set(OWNER_COOKIE, await makeOwnerCookie(password), {
			path: '/',
			httpOnly: true,
			secure: Astro.url.protocol === 'https:',
			sameSite: 'lax',
			maxAge: OWNER_DAYS * 86400,
		});
		return Astro.redirect('/stats', 303);
	} else {
		await noteFailure(db, who);
		error = 'Wrong password.';
		Astro.response.status = 401;
	}
}

const owner = setUp && (await isOwner(Astro.cookies.get(OWNER_COOKIE)?.value, password));

/* ---------- the numbers ---------- */

const ME = 'America/Toronto'; // times are shown in my time zone
const RANGES = [
	{ days: 1, label: '24 hours' },
	{ days: 7, label: '7 days' },
	{ days: 30, label: '30 days' },
	{ days: 90, label: '90 days' },
	{ days: 365, label: 'year' },
];
const days = RANGES.find((r) => r.days === Number(Astro.url.searchParams.get('days')))?.days ?? 30;
const page = Math.max(0, Math.floor(Number(Astro.url.searchParams.get('page')) || 0)); // for "more people"
const personParam = Astro.url.searchParams.get('person') ?? '';
const person = /^[a-z0-9-]{8,40}$/.test(personParam) ? personParam : ''; // one visitor's page
const now = Date.now();
const since = now - days * 86400000;
const PAGE = 50;

// the steps of the trail, named like the bar at the bottom of the site (ids match each section's data-shot)
const stepIds = ['intro', 'start', ...projects.map((p) => p.id), 'summit', 'contact'];
const stepNames = ['start', 'about me', ...projects.map((p) => p.name.replace(' Simulator', '')), 'the summit', 'say hi'];
const sectionName: Record<string, string> = Object.fromEntries(stepIds.map((id, i) => [id, stepNames[i]]));

interface Visit {
	id: string;
	visitor: string;
	started: number;
	last_seen: number;
	active_ms: number;
	city: string | null;
	region: string | null;
	country: string | null;
	timezone: string | null;
	network: string | null;
	referrer: string | null;
	landing: string | null;
	device: string | null;
	furthest: number;
	steps: number;
}
interface Event {
	visit: string;
	at: number;
	kind: string;
	target: string | null;
	detail: string | null;
	section: string | null;
}
// one row per visitor (one browser), described by their most recent visit
interface Person {
	visitor: string;
	visits: number;
	first: number;
	last: number;
	active: number;
	furthest: number | null;
	from_linkedin: number;
	city: string | null;
	region: string | null;
	country: string | null;
	timezone: string | null;
	network: string | null;
	device: string | null;
}
type Row = Record<string, any>;
interface Flags {
	resume?: number;
	email?: number;
	linkedin?: number;
	github?: number;
}

let data: null | {
	totals: Row;
	returning: number;
	interest: Row;
	clicks: Row[];
	places: Row[];
	networks: Row[];
	referrers: Row[];
	buckets: { label: string; visits: number; people: number }[];
	people: Person[];
	flags: Map<string, Flags>;
	morePeople: boolean;
} = null;

let personData: null | { visits: Visit[]; eventsFor: Map<string, Event[]> } = null;

const all = (sql: string, ...params: unknown[]) => db!.prepare(sql).bind(...params);

if (owner && db && person) {
	const [visits, events] = await db.batch([
		all('SELECT * FROM visits WHERE visitor = ? ORDER BY started DESC LIMIT 200', person),
		all(
			`SELECT visit, at, kind, target, detail, section FROM events
			 WHERE visit IN (SELECT id FROM visits WHERE visitor = ?) ORDER BY at`,
			person,
		),
	]);
	const eventsFor = new Map<string, Event[]>();
	for (const e of (events.results ?? []) as Event[]) eventsFor.set(e.visit, [...(eventsFor.get(e.visit) ?? []), e]);
	personData = { visits: (visits.results ?? []) as Visit[], eventsFor };
} else if (owner && db) {
	// anything older than a year goes
	const cutoff = now - 366 * 86400000;
	const results = await db.batch([
		all('DELETE FROM events WHERE at < ?', cutoff),
		all('DELETE FROM visits WHERE started < ?', cutoff),
		all(
			`SELECT COUNT(*) AS visits, COUNT(DISTINCT visitor) AS people, COALESCE(AVG(active_ms), 0) AS avg_active,
				COALESCE(SUM(steps > 0 AND furthest >= steps - 1), 0) AS reached_end
			 FROM visits WHERE started >= ?`,
			since,
		),
		all(
			`SELECT COUNT(*) AS n FROM (SELECT visitor FROM visits
				WHERE visitor IN (SELECT visitor FROM visits WHERE started >= ?) GROUP BY visitor HAVING COUNT(*) > 1)`,
			since,
		),
		all(
			`SELECT COUNT(DISTINCT CASE WHEN detail LIKE '%.pdf' THEN visit END) AS resume,
				COUNT(DISTINCT CASE WHEN detail LIKE 'mailto:%' THEN visit END) AS email,
				COUNT(DISTINCT CASE WHEN detail LIKE '%linkedin.com%' THEN visit END) AS linkedin,
				COUNT(DISTINCT CASE WHEN detail LIKE '%github.com%' THEN visit END) AS github
			 FROM events WHERE kind = 'click' AND at >= ?`,
			since,
		),
		all(
			`SELECT target, detail, section, COUNT(*) AS n, COUNT(DISTINCT visit) AS visits FROM events
			 WHERE kind = 'click' AND at >= ? GROUP BY target, detail, section ORDER BY n DESC LIMIT 20`,
			since,
		),
		all(
			`SELECT city, region, country, COUNT(DISTINCT visitor) AS people, COUNT(*) AS visits FROM visits
			 WHERE started >= ? GROUP BY city, region, country ORDER BY people DESC, visits DESC LIMIT 15`,
			since,
		),
		all(
			`SELECT network, COUNT(DISTINCT visitor) AS people FROM visits
			 WHERE started >= ? AND network IS NOT NULL GROUP BY network ORDER BY people DESC LIMIT 12`,
			since,
		),
		all(
			`SELECT COALESCE(referrer, '') AS referrer, COUNT(*) AS visits FROM visits
			 WHERE started >= ? GROUP BY referrer ORDER BY visits DESC LIMIT 12`,
			since,
		),
		all(
			`SELECT started / 3600000 AS hour, COUNT(*) AS visits, COUNT(DISTINCT visitor) AS people FROM visits
			 WHERE started >= ? GROUP BY hour`,
			since,
		),
		all(
			`WITH p AS (
				SELECT visitor, COUNT(*) AS visits, MIN(started) AS first, MAX(last_seen) AS last, SUM(active_ms) AS active,
					MAX(CASE WHEN steps > 0 THEN furthest END) AS furthest,
					MAX(COALESCE(referrer, '') LIKE '%linkedin%' OR COALESCE(referrer, '') LIKE '%lnkd%') AS from_linkedin
				FROM visits WHERE started >= ? GROUP BY visitor ORDER BY last DESC LIMIT ? OFFSET ?
			)
			SELECT p.*, v.city, v.region, v.country, v.timezone, v.network, v.device FROM p
			JOIN visits v ON v.id = (SELECT w.id FROM visits w WHERE w.visitor = p.visitor ORDER BY w.last_seen DESC LIMIT 1)
			ORDER BY p.last DESC`,
			since,
			PAGE + 1,
			page * PAGE,
		),
	]);
	const rows = (i: number) => (results[i].results ?? []) as Row[];
	const people = rows(10) as Person[];
	const morePeople = people.length > PAGE;
	if (morePeople) people.length = PAGE;

	// what each of those people clicked, for their tags
	const flags = new Map<string, Flags>();
	if (people.length) {
		const found = await db
			.prepare(
				`SELECT v.visitor, MAX(e.detail LIKE '%.pdf') AS resume, MAX(e.detail LIKE 'mailto:%') AS email,
					MAX(e.detail LIKE '%linkedin.com%') AS linkedin, MAX(e.detail LIKE '%github.com%') AS github
				 FROM events e JOIN visits v ON v.id = e.visit
				 WHERE e.kind = 'click' AND v.visitor IN (SELECT value FROM json_each(?)) GROUP BY v.visitor`,
			)
			.bind(JSON.stringify(people.map((p) => p.visitor)))
			.all<Flags & { visitor: string }>();
		for (const f of found.results ?? []) flags.set(f.visitor, f);
	}

	// visits over time, in my time zone: by hour for a day, by day up to 90 days, by month for a year
	const unit = days === 1 ? 'hour' : days <= 90 ? 'day' : 'month';
	const keyFormat = new Intl.DateTimeFormat('en-US', {
		timeZone: ME,
		...(unit === 'hour' ? { weekday: 'short', hour: 'numeric' } : unit === 'day' ? { month: 'short', day: 'numeric' } : { month: 'short', year: 'numeric' }),
	});
	const buckets = new Map<string, { label: string; visits: number; people: number }>();
	for (let t = since; t <= now; t += 3600000) {
		const label = keyFormat.format(t);
		if (!buckets.has(label)) buckets.set(label, { label, visits: 0, people: 0 });
	}
	for (const r of rows(9)) {
		const b = buckets.get(keyFormat.format(r.hour * 3600000));
		if (!b) continue;
		b.visits += r.visits;
		b.people += r.people; // (close enough: someone visiting in two different hours of a day counts twice)
	}

	data = {
		totals: rows(2)[0] ?? {},
		returning: rows(3)[0]?.n ?? 0,
		interest: rows(4)[0] ?? {},
		clicks: rows(5),
		places: rows(6),
		networks: rows(7),
		referrers: rows(8),
		buckets: [...buckets.values()],
		people,
		flags,
		morePeople,
	};
}

/* ---------- formatting ---------- */

const when = (ms: number, timeZone = ME) =>
	new Intl.DateTimeFormat('en-US', { timeZone, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(ms);
const clock = (ms: number, timeZone = ME) => {
	try {
		return new Intl.DateTimeFormat('en-US', { timeZone, hour: 'numeric', minute: '2-digit', second: '2-digit' }).format(ms);
	} catch {
		return '';
	}
};
// what time it was for them, when that's different from mine (a 9am visit is probably someone at work)
const theirTime = (ms: number, timeZone: string | null) => {
	if (!timeZone) return '';
	try {
		const format = (tz: string) => new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(ms);
		const theirs = format(timeZone);
		return theirs === format(ME) ? '' : `${theirs} their time`;
	} catch {
		return '';
	}
};
const duration = (ms: number) => {
	const s = Math.round(ms / 1000);
	if (s < 60) return `${s}s`;
	const m = Math.floor(s / 60);
	return m < 60 ? `${m}m ${s % 60}s` : `${Math.floor(m / 60)}h ${m % 60}m`;
};
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const countries = new Intl.DisplayNames(['en'], { type: 'region' });
const countryName = (code: string | null) => {
	try {
		return code ? (countries.of(code) ?? code) : '';
	} catch {
		return code ?? '';
	}
};
const place = (r: { city: string | null; region: string | null; country: string | null }) =>
	[r.city, r.region, countryName(r.country)].filter(Boolean).join(', ') || 'unknown place';
const linkName = (detail: string | null) => {
	if (!detail) return '';
	if (detail.startsWith('mailto:')) return 'email';
	try {
		const u = new URL(detail);
		return u.origin === Astro.url.origin ? u.pathname + u.hash : u.hostname.replace(/^www\./, '') + u.pathname.replace(/\/$/, '');
	} catch {
		return detail;
	}
};
const stepName = (index: number | null) => (index == null || index < 0 ? '' : stepNames[Math.min(index, stepNames.length - 1)]);
const personLink = (visitor: string) => `/stats?days=${days}&person=${encodeURIComponent(visitor)}`;

// the things that hint someone's actually interested (like a recruiter would be)
function tagsFrom(f: Flags & { fromLinkedin?: boolean; visits?: number; active: number }) {
	const tags: string[] = [];
	if (f.fromLinkedin) tags.push('from LinkedIn');
	if (f.resume) tags.push('opened résumé');
	if (f.email) tags.push('clicked email');
	if (f.linkedin) tags.push('opened LinkedIn');
	if (f.github) tags.push('opened GitHub');
	if (f.visits && f.visits > 1) tags.push(`came ${f.visits > 9 ? '10+' : f.visits} times`);
	if (f.active > 120000) tags.push('stayed 2+ min');
	return tags;
}
const clicked = (list: Event[], test: (detail: string) => boolean) => (list.some((e) => e.kind === 'click' && e.detail && test(e.detail)) ? 1 : 0);
const visitFlags = (list: Event[]): Flags => ({
	resume: clicked(list, (d) => d.endsWith('.pdf')),
	email: clicked(list, (d) => d.startsWith('mailto:')),
	linkedin: clicked(list, (d) => d.includes('linkedin.com')),
	github: clicked(list, (d) => d.includes('github.com')),
});
const fromLinkedin = (referrer: string | null) => Boolean(referrer && /linkedin|lnkd/.test(referrer));

function describe(e: Event) {
	if (e.kind === 'page') return { verb: 'opened', what: e.target ?? '/' };
	if (e.kind === 'section') return { verb: 'reached', what: sectionName[e.target ?? ''] ?? e.target ?? '' };
	const where = e.section ? ` in ${sectionName[e.section] ?? e.section}` : '';
	const to = linkName(e.detail);
	return { verb: 'clicked', what: `“${e.target}”${where}${to ? ` → ${to}` : ''}` };
}

const peak = Math.max(0, ...(data?.buckets.map((b) => b.visits) ?? [0]));
const maxBucket = Math.max(1, peak);

// one person's page: the details from their latest visit, and everything they did added up
const latest = personData?.visits[0];
const personTotals = personData && {
	active: personData.visits.reduce((sum, v) => sum + v.active_ms, 0),
	first: Math.min(...personData.visits.map((v) => v.started)),
	tags: tagsFrom({
		...visitFlags([...personData.eventsFor.values()].flat()),
		fromLinkedin: personData.visits.some((v) => fromLinkedin(v.referrer)),
		visits: personData.visits.length,
		active: personData.visits.reduce((sum, v) => sum + v.active_ms, 0),
	}),
};
---

<Base title="stats" track={false}>
	<main class="stats">
		{
			!setUp && (
				<section class="card gate">
					<h1>stats</h1>
					<p>
						This isn't set up yet. It needs the stats database and the <code>STATS_PASSWORD</code> secret: see "visitor stats" in the README.
					</p>
				</section>
			)
		}

		{
			setUp && !owner && (
				<form class="card gate" method="post" action="/stats">
					<h1>stats</h1>
					<label for="password">password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
					{error && (
						<p class="error" role="alert">
							{error}
						</p>
					)}
					<button type="submit">open</button>
				</form>
			)
		}

		{
			personData && (
				<>
					<header class="top">
						<div>
							<a class="back" href={`/stats?days=${days}`}>
								← everyone
							</a>
							<h1>{latest ? place(latest) : 'nobody here'}</h1>
							{latest && <p class="muted">{[latest.network, latest.device].filter(Boolean).join(' · ')}</p>}
						</div>
						<form method="post" action="/stats">
							<input type="hidden" name="action" value="logout" />
							<button class="quiet" type="submit">log out</button>
						</form>
					</header>

					{!latest && (
						<section class="card wide">
							<p class="muted">No visits from this person. Visits older than a year get deleted.</p>
						</section>
					)}

					{latest && personTotals && (
						<>
							<section class="tiles">
								<div class="tile">
									<span class="label">visits</span>
									<b>{personData.visits.length}</b>
									<span class="muted">first came {when(personTotals.first)}</span>
								</div>
								<div class="tile">
									<span class="label">last seen</span>
									<b class="small">{when(latest.last_seen)}</b>
									<span class="muted">{theirTime(latest.last_seen, latest.timezone) || 'Toronto time'}</span>
								</div>
								<div class="tile">
									<span class="label">time on the site</span>
									<b>{duration(personTotals.active)}</b>
									<span class="muted">all visits added up</span>
								</div>
							</section>
							{personTotals.tags.length > 0 && (
								<p class="tags">
									{personTotals.tags.map((t) => (
										<span class="tag">{t}</span>
									))}
								</p>
							)}
						</>
					)}

					{personData.visits.map((v, n) => {
						const list = personData.eventsFor.get(v.id) ?? [];
						const reached = new Set(list.filter((e) => e.kind === 'section').map((e) => e.target));
						const tags = tagsFrom({ ...visitFlags(list), fromLinkedin: fromLinkedin(v.referrer), active: v.active_ms });
						return (
							<section class="card wide visit">
								<div class="visit-head">
									<h2>
										visit {personData.visits.length - n} · {when(v.started)}
										<span class="muted"> {theirTime(v.started, v.timezone)}</span>
									</h2>
									<p class="muted">
										{duration(v.active_ms)} on screen · {v.referrer ? `came from ${v.referrer}` : 'no referrer'}
										{v.landing && v.landing.includes('?') ? ` · ${v.landing}` : ''}
										{' · '}
										{place(v)}
										{v.network ? ` · ${v.network}` : ''}
										{v.device ? ` · ${v.device}` : ''}
									</p>
								</div>
								<ol class="trail" aria-label="the steps of the trail this visit reached">
									{stepIds.map((id, i) => (
										<li class={reached.has(id) ? 'on' : undefined}>
											<span class="dot" aria-hidden="true" />
											<span>{stepNames[i]}</span>
											<span class="sr">{reached.has(id) ? '(reached)' : '(not reached)'}</span>
										</li>
									))}
								</ol>
								{tags.length > 0 && (
									<p class="tags">
										{tags.map((t) => (
											<span class="tag">{t}</span>
										))}
									</p>
								)}
								<h3>what they did</h3>
								{list.length ? (
									<ol class="timeline">
										{list.map((e, i) => {
											const d = describe(e);
											const gap = i ? e.at - list[i - 1].at : 0;
											return (
												<li class={e.kind}>
													<span class="muted at">{clock(e.at)}</span>
													<span>
														{d.verb} <b>{d.what}</b>
														{gap >= 1000 && <span class="muted"> · {duration(gap)} later</span>}
													</span>
												</li>
											);
										})}
									</ol>
								) : (
									<p class="muted">nothing recorded for this visit</p>
								)}
							</section>
						);
					})}
				</>
			)
		}

		{
			data && (
				<>
					<header class="top">
						<div>
							<h1>stats</h1>
							<p class="muted">times are Toronto time · your own visits aren't counted while you're logged in</p>
						</div>
						<nav class="ranges" aria-label="time range">
							{RANGES.map((r) => (
								<a href={`/stats?days=${r.days}`} aria-current={r.days === days ? 'page' : undefined}>
									{r.label}
								</a>
							))}
						</nav>
						<form method="post" action="/stats">
							<input type="hidden" name="action" value="logout" />
							<button class="quiet" type="submit">log out</button>
						</form>
					</header>

					<section class="tiles">
						<div class="tile">
							<span class="label">people</span>
							<b>{data.totals.people ?? 0}</b>
							<span class="muted">
								{plural(data.totals.visits ?? 0, 'visit')} · {data.returning} came back
							</span>
						</div>
						<div class="tile">
							<span class="label">time on the site</span>
							<b>{duration(data.totals.avg_active ?? 0)}</b>
							<span class="muted">average per visit</span>
						</div>
						<div class="tile">
							<span class="label">made it to the end</span>
							<b>{data.totals.reached_end ?? 0}</b>
							<span class="muted">of {plural(data.totals.visits ?? 0, 'visit')} reached "say hi"</span>
						</div>
						<div class="tile">
							<span class="label">opened résumé</span>
							<b>{data.interest.resume ?? 0}</b>
							<span class="muted">
								{data.interest.email ?? 0} email · {data.interest.linkedin ?? 0} LinkedIn · {data.interest.github ?? 0} GitHub
							</span>
						</div>
					</section>

					<section class="card wide">
						<h2>people, most recent first</h2>
						<p class="muted">pick someone to see each of their visits and where they went</p>
						{data.people.length ? (
							<ul class="people">
								{data.people.map((p) => {
									const tags = tagsFrom({ ...data.flags.get(p.visitor), fromLinkedin: Boolean(p.from_linkedin), visits: p.visits, active: p.active });
									const furthest = stepName(p.furthest);
									return (
										<li>
											<a class="person" href={personLink(p.visitor)}>
												<span class="when">
													<b>{when(p.last)}</b>
													<span class="muted">{theirTime(p.last, p.timezone)}</span>
												</span>
												<span class="who">
													<b>{place(p)}</b>
													<span class="muted">{[p.network, p.device].filter(Boolean).join(' · ')}</span>
												</span>
												<span class="how">
													<span>{furthest ? `got as far as ${furthest}` : 'opened a page'}</span>
													<span class="muted">
														{plural(p.visits, 'visit')} · {duration(p.active)}
													</span>
													<span class="mini" aria-hidden="true">
														{stepIds.map((_, i) => (
															<i class={p.furthest != null && i <= p.furthest ? 'on' : undefined} />
														))}
													</span>
												</span>
												<span class="go" aria-hidden="true">
													→
												</span>
												{tags.length > 0 && (
													<span class="tags">
														{tags.map((t) => (
															<span class="tag">{t}</span>
														))}
													</span>
												)}
											</a>
										</li>
									);
								})}
							</ul>
						) : (
							<p class="muted">nobody in this range yet</p>
						)}
						<p class="pager">
							{page > 0 && <a href={`/stats?days=${days}${page > 1 ? `&page=${page - 1}` : ''}`}>← newer</a>}
							{data.morePeople && <a href={`/stats?days=${days}&page=${page + 1}`}>older people →</a>}
						</p>
					</section>

					<section class="card wide">
						<h2>visits</h2>
						<div class="columns" style={`--n: ${data.buckets.length}`} role="img" aria-label="visits over time">
							{data.buckets.map((b) => (
								<span class="column" tabindex="0" data-tip={`${b.label}: ${plural(b.visits, 'visit')}`}>
									<i style={`--h: ${b.visits / maxBucket}`} />
								</span>
							))}
						</div>
						<div class="axis muted">
							<span>{data.buckets[0]?.label}</span>
							<span>tallest bar: {peak}</span>
							<span>{data.buckets.at(-1)?.label}</span>
						</div>
					</section>

					<div class="grid">
						<section class="card">
							<h2>what they clicked</h2>
							{data.clicks.length ? (
								<table>
									<thead>
										<tr>
											<th>click</th>
											<th class="num">times</th>
										</tr>
									</thead>
									<tbody>
										{data.clicks.map((c) => (
											<tr>
												<td>
													{c.target}
													<span class="muted">
														{c.section ? ` · ${sectionName[c.section] ?? c.section}` : ''}
														{c.detail ? ` → ${linkName(c.detail)}` : ''}
													</span>
												</td>
												<td class="num">{c.n}</td>
											</tr>
										))}
									</tbody>
								</table>
							) : (
								<p class="muted">no clicks yet</p>
							)}
						</section>

						<section class="card">
							<h2>where they are</h2>
							<p class="muted">from their internet connection, so it's approximate (a VPN or work network can move it)</p>
							<table>
								<thead>
									<tr>
										<th>place</th>
										<th class="num">people</th>
									</tr>
								</thead>
								<tbody>
									{data.places.map((p) => (
										<tr>
											<td>{place(p as any)}</td>
											<td class="num">{p.people}</td>
										</tr>
									))}
								</tbody>
							</table>
						</section>

						<section class="card">
							<h2>their network</h2>
							<p class="muted">who runs their internet: usually an ISP, sometimes a school or a company</p>
							<table>
								<tbody>
									{data.networks.map((n) => (
										<tr>
											<td>{n.network}</td>
											<td class="num">{n.people}</td>
										</tr>
									))}
								</tbody>
							</table>
						</section>

						<section class="card">
							<h2>where they came from</h2>
							<table>
								<tbody>
									{data.referrers.map((r) => (
										<tr>
											<td>{r.referrer || 'typed it in / a link with no source'}</td>
											<td class="num">{r.visits}</td>
										</tr>
									))}
								</tbody>
							</table>
							<p class="muted tip">
								tip: put <code>?ref=resume</code> (or <code>?ref=linkedin</code>) on the links you hand out, and it shows on that person's visits
							</p>
						</section>
					</div>
				</>
			)
		}
	</main>
</Base>

