---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>About | Adib El Dada</title>
	</head>

	<body>
		<Header />

		<main>
			<h1>About Me</h1>

			<p>
				I'm Adib El Dada, a third-year Software Engineering &amp; Management student
				at McMaster, looking for a co-op starting May 2027.
			</p>

			<p>
				I can build whatever I want, but I choose to build things that help people,
				usually people I know.
			</p>

			<p>
				Everything I've built is on the trail map at
				<a href="/">adibeldada.com</a>.
			</p>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 5rem 2rem;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: 2rem;
	}

	p {
		font-size: 1.15rem;
		line-height: 1.8;
		margin-bottom: 1.5rem;
	}
</style>