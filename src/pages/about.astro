---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>About | Adib El Dada</title>
	</head>

	<body>
		<Header />

		<main>
			<h1>About Me</h1>

			<p>
				I'm Adib El Dada, a Software Engineering and Management student
				at McMaster University.
			</p>

			<p>
				I enjoy building full-stack applications, participating in hackathons,
				and exploring areas such as artificial intelligence, cybersecurity,
				and emerging technologies.
			</p>

			<p>
				This portfolio is a work in progress. More projects, experience,
				and information will be added soon.
			</p>
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 5rem 2rem;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: 2rem;
	}

	p {
		font-size: 1.15rem;
		line-height: 1.8;
		margin-bottom: 1.5rem;
	}
</style>